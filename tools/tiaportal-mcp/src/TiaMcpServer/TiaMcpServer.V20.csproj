<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyVersion>2.7.4</AssemblyVersion>
    <AssemblyName>TiaMcpServer</AssemblyName>
    <BaseOutputPath>.\bin-v20</BaseOutputPath>
    <BaseIntermediateOutputPath>.\obj-v20\</BaseIntermediateOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefineConstants>$(DefineConstants);TIA_V20</DefineConstants>
    <TiaPortalLocation>D:\app\TIA20\Portal V20</TiaPortalLocation>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-v20\**;bin\**;bin-v20\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- SDK 侧三个包与 TiaMcpServer.csproj（V21）保持一致：同一份源码两个工程共用，
         版本不一致会让 V20 编不过（0.3.0-preview.4 没有 McpProtocolException），
         也会让两边解析出不同的 Microsoft.Extensions.* 版本。Siemens 侧仍保持 V20 专属钉版本。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Sharp7" Version="1.1.84" />
    <PackageReference Include="Workstation.UaClient" Version="3.2.3" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="1.1.1725480302" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="20.0.1744190253" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Management.dll</HintPath>
    </Reference>
    <!-- 与 TiaMcpServer.csproj（V21）一致：同一份源码两个工程共用，缺了它 V20 编不过。 -->
    <Reference Include="System.DirectoryServices.AccountManagement" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Include="tests\**" />
  </ItemGroup>
</Project>
