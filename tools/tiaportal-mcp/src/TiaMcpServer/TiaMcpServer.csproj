<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>
        <OutputType>Exe</OutputType>
        <AssemblyVersion>2.7.3</AssemblyVersion>
        <BaseOutputPath>.\bin</BaseOutputPath>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-v20\**;bin\**;bin-v20\**</DefaultItemExcludes>
        <!-- Release builds ship no .pdb, so the debug directory only served to embed the
             builder's absolute source path (an RSDS entry naming the private repo tree)
             into every published exe. Nothing reads it once the .pdb is gone. -->
        <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
        <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
        <PackageReference Include="Sharp7" Version="1.1.84"/>
        <PackageReference Include="Workstation.UaClient" Version="3.2.3"/>
        <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661"/>
        <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="2.0.1765367256" />
        <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="21.0.1765349347"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="System.Management">
            <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Management.dll</HintPath>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="tests\**"/>
        <None Include="tests\**"/>
    </ItemGroup>
</Project>
