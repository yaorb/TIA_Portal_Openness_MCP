<Project Sdk="Microsoft.NET.Sdk">
  <!--
    最小离线自检套件。

    为什么是控制台 Exe 而不是 VSTest 工程：这里链接的是引擎的**源文件**，
    而引擎主体依赖 Siemens.Engineering.dll（需要本机装了 TIA Portal 才编得动），
    托管不了整个工程。所以只把**零依赖**的那几个文件链进来，用 `dotnet run` 驱动。

    ⚠️ 千万别用 `dotnet test` 跑它：那样只会还原、一个用例都不跑、然后退 0 ——
    一个和「全部通过」长得一模一样的假绿灯。CI 里写死的是 `dotnet run`。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- HMI 模板布局体检 + 执行 JSON 构建器：两个都零依赖。
         盯的是「执行 JSON 检查」那条 —— 它曾经在委托缺省时退化成
         `items.Length > 0 && errors.Count == 0`，判据里含着 errors.Count == 0，
         永远不可能新增错误，而发版前的离线验收闸走的正是那条空转路径。
         恒不触发的检查只有会失败的用例盯得住，而且必须同时盯 API 形状：
         委托一旦被改回可选，空转路径立刻复活，运行期用例一条都不会红。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiTemplateLayoutAnalyzer.cs" Link="HmiTemplateLayoutAnalyzer.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiTemplateDesignJsonBuilder.cs" Link="HmiTemplateDesignJsonBuilder.cs" />
    <!-- .s7res 的 en-US 扫描。原实现埋在依赖 MCP SDK 的大文件里，用 XML 解析器读 YAML，
         对每个真实文件都抛异常又被 catch 吞掉，坏了很久没人发现 —— 抽成零依赖文件
         就是为了能在这里被测到。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\S7ResScanner.cs" Link="S7ResScanner.cs" />
    <!-- 参数诊断的判定逻辑与大响应寄存库：两个都零依赖，专门抽成这样就是为了能在这里被喂真输入。
         这两块坏了都不会崩 —— 一个只是少说一句话，一个只是让某一页文本报废 —— 属于
         「坏了也悄无声息」那一类，只有会失败的用例盯得住。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ArgDiagnostics.cs" Link="ArgDiagnostics.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ExportStore.cs" Link="ExportStore.cs" />
    <!-- 「进程没了」和「这步失败了」的分类器。抽成零依赖文件就是为了能在这里被喂输入：
         它埋在依赖 Siemens.Engineering 的大文件里时，没装博途的机器一行都测不到，
         而崩溃路径本来就少见 —— 判错了也悄无声息，属于只有会失败的用例盯得住的那类。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\PortalFailureClassifier.cs" Link="PortalFailureClassifier.cs" />
    <!-- 画面分组递归（PR #41）：分组里的画面曾对所有画面工具隐形，只报一句「找不到」。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiScreenWalk.cs" Link="HmiScreenWalk.cs" />
    <!-- DescribeBlockLogic 的回读（issue #42）：错了不报错、不崩，只会让人看到不存在的逻辑。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\SimaticMlText.cs" Link="SimaticMlText.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\LadTextRenderer.cs" Link="LadTextRenderer.cs" />
    <!-- Openness 用户组判定：原实现把「本机组成员列表里有这个人、只是登录令牌过期」报成
         「当前用户不在组里」，两种修法（加人 / 注销重登）完全不同。判定拆成零依赖的纯函数
         就是为了能在这里把 27 种探测组合全枚举一遍，钉住「只有 InGroup 才允许 Ok」。 -->
    <Compile Include="..\..\src\TiaMcpServer\Runtime\OpennessGroupCheck.cs" Link="OpennessGroupCheck.cs" />
  </ItemGroup>
</Project>
